{
  "name": "@izanagi-labs/ingestx",
  "version": "1.0.4",
  "packageManager": "pnpm@11.1.2",
  "description": "High performance CSV and Excel ingestion library for React and Node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Izanagi-Labs/IngestX.git"
  },
  "homepage": "https://github.com/Izanagi-Labs/IngestX#readme",
  "author": "Nikhil Dabhade",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "demo": "cd apps/web && yarn dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:check": "eslint .",
    "benchmark": "npx tsx benchmarks/excelParser.benchmark.ts && npx tsx benchmarks/csvParser.benchmark.ts",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:start": "pnpm --filter web start"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^3.7.2",
    "vitest": "^1.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "xlsx": "^0.18.5"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "ingestx",
    "react",
    "reactjs",
    "node",
    "nodejs",
    "typescript",
    "csv",
    "excel",
    "xlsx",
    "spreadsheet",
    "parser",
    "data-import",
    "bulk-import",
    "data-validation",
    "file-upload",
    "streaming",
    "chunked-processing",
    "large-files",
    "etl",
    "ingestion"
  ]
}
